# TidalHabits .dockerignore
# (雖然這是 iOS 專案,但如果未來需要容器化腳本或工具時可用)

# Git
.git
.gitignore
.gitattributes

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml
circle.yml

# Documentation
docs/
*.md
README*
LICENSE
CHANGELOG*

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Xcode
build/
DerivedData/
xcuserdata/
*.xcworkspace
*.xcodeproj

# Dependencies
Pods/
Carthage/
.build/
.swiftpm/

# Tests
*Tests/
*UITests/
test/
coverage/

# Temporary files
tmp/
temp/
*.tmp
*.log

# IDE
.vscode/
.idea/
*.swp
*.swo

# Node modules (如有腳本工具)
node_modules/
npm-debug.log*

# Python (如有腳本)
__pycache__/
*.py[cod]
venv/
env/

# Output
output/
dist/
screenshots/

# Sensitive
.env
.env.*
secrets/
credentials/
*.p12
*.mobileprovision
*.cer
