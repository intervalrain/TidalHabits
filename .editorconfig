# EditorConfig for TidalHabits
# https://editorconfig.org

root = true

# All files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Swift files
[*.swift]
indent_style = space
indent_size = 4
max_line_length = 120

# Markdown files
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# YAML files
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# JSON files
[*.json]
indent_style = space
indent_size = 2

# Shell scripts
[*.sh]
indent_style = space
indent_size = 2
end_of_line = lf

# Xcode project files
[*.{pbxproj,xcscheme}]
indent_style = tab

# Property lists
[*.plist]
indent_style = tab

# Storyboard and XIB
[*.{storyboard,xib}]
indent_style = space
indent_size = 2
